<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1014"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="22dp"
        android:paddingEnd="32dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/vodTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vodSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingBottom="4dp"
            android:textColor="#AEB4BA"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/vodCategories"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="#FF080A0D"
            android:clipToPadding="false"
            android:divider="@null"
            android:listSelector="@drawable/list_selector"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <GridView
                android:id="@+id/vodGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:drawSelectorOnTop="true"
                android:horizontalSpacing="12dp"
                android:listSelector="@drawable/poster_selector"
                android:numColumns="4"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="12dp" />

            <ProgressBar
                android:id="@+id/vodLoading"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/vodEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="#AEB4BA"
                android:textSize="22sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF080A0D"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:text="OK  Open      ◀ ▶ ▲ ▼  Move      Back  Return to live TV"
        android:textColor="#C8CCD0"
        android:textSize="17sp" />
</LinearLayout>
