<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_window_focused="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape><solid android:color="@color/focus" /><corners android:radius="12dp" /></shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape><solid android:color="@color/focus" /><corners android:radius="12dp" /></shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
