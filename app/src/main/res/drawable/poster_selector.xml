<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_window_focused="true">
        <shape><solid android:color="#00000000" /><stroke android:width="5dp" android:color="@color/focus" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#33F2A93B" /><stroke android:width="5dp" android:color="@color/focus" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
